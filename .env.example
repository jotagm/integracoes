# Copie para .env (que está no .gitignore) e preencha.

# Postgres do lab (deploy/lab/docker-compose.yml)
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://integracoes:troque-esta-senha@localhost:5433/integracoes?sslmode=disable

# Kafka do lab (deploy/lab/docker-compose.yml)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPICO=atividades

# GitHub: o usuário liga a fonte. O token é opcional (sem ele, 60 req/h; o ETag quase não gasta quota).
GITHUB_USUARIO=jotagm
GITHUB_TOKEN=

# Spotify: as três juntas ligam a fonte. O refresh token vem do OAuth do spotify-top-artists,
# com o escopo user-read-recently-played.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
